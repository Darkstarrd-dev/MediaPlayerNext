{
  "name": "mediaplayernext",
  "private": true,
  "version": "0.1.0",
  "packageManager": "npm@11.4.1",
  "workspaces": [
    "apps/desktop",
    "apps/subtitle-sidecar",
    "packages/contracts"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @mediaplayernext/desktop -- --host 0.0.0.0 --port 1420",
    "build:web": "npm run build --workspace @mediaplayernext/desktop",
    "tauri:dev": ".\\scripts\\run-tauri-dev.cmd",
    "tauri:build": ".\\scripts\\run-tauri-build.cmd",
    "fixtures:scan-placeholders": "node ./scripts/generate-scan-placeholders.mjs",
    "fixtures:scan-placeholders:force": "node ./scripts/generate-scan-placeholders.mjs --force",
    "fixtures:fill-real": "node ./scripts/fill-scan-fixtures-with-realdata.mjs",
    "fixtures:create-run": "node ./scripts/create-scan-validation-run.mjs",
    "test:contracts": "npm run test --workspace @mediaplayernext/contracts",
    "check:subtitle-sidecar": "npm run check --workspace @mediaplayernext/subtitle-sidecar",
    "check:sharp": "npm run check:subtitle-sidecar",
    "check:runtimes": "npm run check:subtitle-sidecar && powershell -NoProfile -ExecutionPolicy Bypass -File \".\\scripts\\check-runtimes.ps1\"",
    "check:paths": "powershell -NoProfile -ExecutionPolicy Bypass -File \".\\scripts\\release\\verify-resource-paths.ps1\"",
    "check:sidecar-package": "powershell -NoProfile -ExecutionPolicy Bypass -File \".\\scripts\\release\\verify-sidecar-package.ps1\"",
    "check:quality": "powershell -NoProfile -ExecutionPolicy Bypass -File \".\\scripts\\quality\\run-rust-gates.ps1\"",
    "check:release": "powershell -NoProfile -ExecutionPolicy Bypass -File \".\\scripts\\quality\\run-release-verify.ps1\"",
    "check": "npm run check:runtimes"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0"
  }
}
