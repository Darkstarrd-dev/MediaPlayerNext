{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MediaPlayerNext",
  "version": "0.1.0",
  "identifier": "com.opencode.mediaplayernext",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:web",
    "frontendDist": "../apps/desktop/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MediaPlayerNext",
        "width": 1280,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../apps/subtitle-sidecar/dist/src/**/*": "sidecar/"
    },
    "targets": "all"
  }
}
